# Per-host build directories (every Makefile builds into build/<hostname>/)
build/

# Built binaries (benchmarks, tests, sanitizer variants)
*_bm
*_gmbm
*_lmbm
*_mbm
*_ppmbm
*_test
*_test_asan
*_test_tsan
*_asan
*_tsan

# Editor leftovers and backups
*.bak
*~
.*.sw?
*.old

# Development version snapshots
V[0-9]/

# Collected measurements
results/

# Book chapter drafts
B32053_*.pdf

# WSL/Windows download metadata
*Zone.Identifier

# Documentation: only READMEs are published
*.md
!README.md

# Third-party code: ThirdParty/<name> holds the upstream git clones, the one
# source; the `imports` targets of the Makefiles that include third_party.mk
# derive the directories the build uses from them (with our patches), so those
# are not tracked either; nor are the <output>.tmp.* leftovers of an import run
# killed outright.
/ThirdParty/
SharedPtr/lock_free_shared_ptr/parlay/
SharedPtr/lock_free_shared_ptr/parlay.tmp.*
IntrSharedPtr/mm_hp/
IntrSharedPtr/mm_hp.tmp.*
